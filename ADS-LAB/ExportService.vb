Imports System.Diagnostics
Imports System.IO
Imports System.Text
Imports ClosedXML.Excel
Imports QuestPDF.Infrastructure

Public Class ExportOptions
    Public Property Format As String = "Excel"
    Public Property Title As String = ""
    Public Property IncludeHeaders As Boolean = True
    Public Property IncludeFooter As Boolean = True
    Public Property Landscape As Boolean = True
    Public Property Delimiter As String = ","
    Public Property Utf8Bom As Boolean = True
End Class

Public Class ExportData
    Public ReadOnly Headers As New List(Of String)()
    Public ReadOnly Rows As New List(Of Object())()
End Class

Public Module ExportService

    ' Shows the options dialog, then exports the grid's visible columns
    Public Sub ExportGrid(grid As DataGridView, owner As IWin32Window, Optional defaultTitle As String = "")
        If grid.Rows.Count = 0 Then
            MessageBox.Show("The table is empty, so there is nothing to export.", "Export", MessageBoxButtons.OK, MessageBoxIcon.Information)
            Return
        End If

        Dim options As ExportOptions
        Using dialog As New ExportOptionsDialog(defaultTitle)
            If dialog.ShowDialog(owner) <> DialogResult.OK Then Return
            options = dialog.Options
        End Using

        Dim extension As String
        Dim filter As String
        Select Case options.Format
            Case "PDF"
                extension = ".pdf"
                filter = "PDF document (*.pdf)|*.pdf"
            Case "CSV"
                extension = ".csv"
                filter = "CSV file (*.csv)|*.csv"
            Case Else
                extension = ".xlsx"
                filter = "Excel workbook (*.xlsx)|*.xlsx"
        End Select

        Dim filePath As String
        Using save As New SaveFileDialog()
            save.Filter = filter
            save.FileName = "report_" & Date.Now.ToString("yyyyMMdd_HHmm") & extension
            If save.ShowDialog(owner) <> DialogResult.OK Then Return
            filePath = save.FileName
        End Using

        ' Copy the data now; the background task must not touch the grid
        Dim data As ExportData = Snapshot(grid)
        Dim footer As String = "Generated by " & SessionManager.Username & " on " & Date.Now.ToString("yyyy-MM-dd HH:mm")

        Dim result As ProgressResult = ProgressRunner.Run(owner, "Exporting",
            Sub(progress As ProgressDialog)
                progress.ReportProgress(5, "Preparing the data...")

                Select Case options.Format
                    Case "PDF"
                        progress.ReportProgress(30, "Writing the PDF file...")
                        PdfExport.ExportRows(data.Headers, data.Rows, options.Title,
                                             filePath, If(options.IncludeFooter, footer, ""), options.Landscape)
                    Case "CSV"
                        WriteCsv(data, options, filePath, progress)
                    Case Else
                        WriteExcel(data, options, filePath, footer, progress)
                End Select

                progress.ReportProgress(100, "Done")
            End Sub)

        If result.Completed Then
            ApplicationLogger.LogInfo("Exported " & data.Rows.Count & " row(s) to " & filePath)
            If MessageBox.Show("Export complete (" & data.Rows.Count & " row(s)). Open the file now?", "Export",
                               MessageBoxButtons.YesNo, MessageBoxIcon.Information) = DialogResult.Yes Then
                Process.Start(New ProcessStartInfo(filePath) With {.UseShellExecute = True})
            End If
        ElseIf result.Cancelled Then
            Try
                If File.Exists(filePath) Then File.Delete(filePath)
            Catch
            End Try
            MessageBox.Show("The export was cancelled.", "Export", MessageBoxButtons.OK, MessageBoxIcon.Information)
        Else
            ApplicationLogger.LogError("Export failed", result.Failure)
            MessageBox.Show("The export failed: " & result.Failure.Message, "Export", MessageBoxButtons.OK, MessageBoxIcon.Warning)
        End If
    End Sub

    Private Function Snapshot(grid As DataGridView) As ExportData
        Dim data As New ExportData()
        Dim columns As List(Of DataGridViewColumn) =
            grid.Columns.Cast(Of DataGridViewColumn)().Where(Function(c) c.Visible).OrderBy(Function(c) c.DisplayIndex).ToList()

        For Each column As DataGridViewColumn In columns
            data.Headers.Add(column.HeaderText)
        Next

        For Each row As DataGridViewRow In grid.Rows
            If row.IsNewRow Then Continue For

            Dim values(columns.Count - 1) As Object
            For i As Integer = 0 To columns.Count - 1
                values(i) = row.Cells(columns(i).Index).Value
            Next
            data.Rows.Add(values)
        Next

        Return data
    End Function

    ' ---------- CSV ----------
    Private Function CsvEscape(value As Object, delimiter As String) As String
        Dim text As String = If(value Is Nothing OrElse IsDBNull(value), "", Convert.ToString(value))
        If text.Contains(delimiter) OrElse text.Contains("""") OrElse text.Contains(vbLf) OrElse text.Contains(vbCr) Then
            text = """" & text.Replace("""", """""") & """"
        End If
        Return text
    End Function

    Private Sub WriteCsv(data As ExportData, options As ExportOptions, filePath As String, progress As ProgressDialog)
        Dim sb As New StringBuilder()

        If options.IncludeHeaders Then
            sb.AppendLine(String.Join(options.Delimiter, data.Headers.Select(Function(h) CsvEscape(h, options.Delimiter))))
        End If

        For i As Integer = 0 To data.Rows.Count - 1
            If progress.IsCancelled Then Throw New OperationCanceledException()

            sb.AppendLine(String.Join(options.Delimiter, data.Rows(i).Select(Function(v) CsvEscape(v, options.Delimiter))))

            If i Mod 100 = 0 Then
                progress.ReportProgress(10 + CInt(80 * i / data.Rows.Count), "Writing row " & (i + 1) & " of " & data.Rows.Count)
            End If
        Next

        File.WriteAllText(filePath, sb.ToString(), New UTF8Encoding(options.Utf8Bom))
    End Sub

    ' ---------- Excel ----------
    Private Sub SetExcelValue(cell As IXLCell, value As Object)
        If value Is Nothing OrElse IsDBNull(value) Then Return

        If TypeOf value Is Date Then
            Dim stamp As Date = CDate(value)
            cell.Value = stamp
            cell.Style.NumberFormat.Format = If(stamp.TimeOfDay = TimeSpan.Zero, "yyyy-mm-dd", "yyyy-mm-dd hh:mm")
        ElseIf TypeOf value Is Decimal OrElse TypeOf value Is Double OrElse TypeOf value Is Single Then
            cell.Value = Convert.ToDouble(value)
            cell.Style.NumberFormat.Format = "0.00"
        ElseIf TypeOf value Is Integer OrElse TypeOf value Is Long OrElse TypeOf value Is Short OrElse TypeOf value Is Byte Then
            cell.Value = Convert.ToDouble(value)
        Else
            cell.Value = Convert.ToString(value)
        End If
    End Sub

    Private Sub WriteExcel(data As ExportData, options As ExportOptions, filePath As String, footer As String, progress As ProgressDialog)
        Using workbook As New XLWorkbook()
            Dim sheet As IXLWorksheet = workbook.Worksheets.Add("Report")
            Dim columnCount As Integer = data.Headers.Count
            Dim r As Integer = 1

            If options.Title <> "" Then
                sheet.Cell(r, 1).Value = options.Title
                sheet.Cell(r, 1).Style.Font.Bold = True
                sheet.Cell(r, 1).Style.Font.FontSize = 14
                r += 2
            End If

            Dim headerRow As Integer = r
            If options.IncludeHeaders Then
                For c As Integer = 0 To columnCount - 1
                    sheet.Cell(r, c + 1).Value = data.Headers(c)
                Next

                Dim headerRange As IXLRange = sheet.Range(r, 1, r, columnCount)
                headerRange.Style.Font.Bold = True
                headerRange.Style.Fill.BackgroundColor = XLColor.LightSteelBlue
                r += 1
            End If

            Dim firstDataRow As Integer = r
            For i As Integer = 0 To data.Rows.Count - 1
                If progress.IsCancelled Then Throw New OperationCanceledException()

                For c As Integer = 0 To columnCount - 1
                    SetExcelValue(sheet.Cell(r, c + 1), data.Rows(i)(c))
                Next
                r += 1

                If i Mod 100 = 0 Then
                    progress.ReportProgress(10 + CInt(75 * i / data.Rows.Count), "Writing row " & (i + 1) & " of " & data.Rows.Count)
                End If
            Next
            Dim lastDataRow As Integer = r - 1

            If options.IncludeFooter Then
                r += 1
                sheet.Cell(r, 1).Value = footer
                sheet.Cell(r, 1).Style.Font.Italic = True
                sheet.Cell(r, 1).Style.Font.FontColor = XLColor.Gray
            End If

            progress.ReportProgress(90, "Formatting the workbook...")
            sheet.Columns().AdjustToContents()

            If options.IncludeHeaders Then
                sheet.SheetView.FreezeRows(headerRow)
                If lastDataRow >= firstDataRow Then
                    sheet.Range(headerRow, 1, lastDataRow, columnCount).SetAutoFilter()
                End If
            End If

            workbook.SaveAs(filePath)
        End Using
    End Sub

End Module

' ---------- Options dialog ----------
Friend Class ExportOptionsDialog
    Inherits Form

    Private ReadOnly _cmbFormat As New ComboBox()
    Private ReadOnly _txtTitle As New TextBox()
    Private ReadOnly _chkHeaders As New CheckBox()
    Private ReadOnly _chkFooter As New CheckBox()
    Private ReadOnly _cmbOrientation As New ComboBox()
    Private ReadOnly _cmbDelimiter As New ComboBox()
    Private ReadOnly _chkBom As New CheckBox()
    Private ReadOnly _result As New ExportOptions()

    Public ReadOnly Property Options As ExportOptions
        Get
            Return _result
        End Get
    End Property

    Public Sub New(defaultTitle As String)
        Me.Text = "Export Options"
        Me.FormBorderStyle = FormBorderStyle.FixedDialog
        Me.StartPosition = FormStartPosition.CenterParent
        Me.MinimizeBox = False
        Me.MaximizeBox = False
        Me.ShowInTaskbar = False
        Me.AutoSize = True
        Me.AutoSizeMode = AutoSizeMode.GrowAndShrink
        Me.Padding = New Padding(14)

        _cmbFormat.DropDownStyle = ComboBoxStyle.DropDownList
        _cmbFormat.Items.AddRange({"Excel workbook (.xlsx)", "PDF document (.pdf)", "CSV file (.csv)"})
        _cmbFormat.SelectedIndex = 0
        AddHandler _cmbFormat.SelectedIndexChanged, Sub(s, e) UpdateEnabled()

        _txtTitle.Text = defaultTitle
        _txtTitle.Width = 220

        _chkHeaders.Text = "Include column headers"
        _chkHeaders.Checked = True
        _chkHeaders.AutoSize = True

        _chkFooter.Text = "Add who generated the file and when"
        _chkFooter.Checked = True
        _chkFooter.AutoSize = True

        _cmbOrientation.DropDownStyle = ComboBoxStyle.DropDownList
        _cmbOrientation.Items.AddRange({"Landscape", "Portrait"})
        _cmbOrientation.SelectedIndex = 0

        _cmbDelimiter.DropDownStyle = ComboBoxStyle.DropDownList
        _cmbDelimiter.Items.AddRange({"Comma ( , )", "Semicolon ( ; )", "Tab"})
        _cmbDelimiter.SelectedIndex = 0

        _chkBom.Text = "Use UTF-8 with BOM (recommended for Excel)"
        _chkBom.Checked = True
        _chkBom.AutoSize = True

        Dim layout As New FlowLayoutPanel()
        layout.AutoSize = True
        layout.FlowDirection = FlowDirection.TopDown
        layout.WrapContents = False

        layout.Controls.Add(MakeRow("Format", _cmbFormat))
        layout.Controls.Add(MakeRow("Title", _txtTitle))
        layout.Controls.Add(_chkHeaders)
        layout.Controls.Add(_chkFooter)
        layout.Controls.Add(MakeRow("PDF page", _cmbOrientation))
        layout.Controls.Add(MakeRow("CSV separator", _cmbDelimiter))
        layout.Controls.Add(_chkBom)

        Dim btnExport As New Button()
        btnExport.Text = "Export"
        btnExport.AutoSize = True
        AddHandler btnExport.Click, AddressOf OnExportClicked

        Dim btnCancel As New Button()
        btnCancel.Text = "Cancel"
        btnCancel.AutoSize = True
        btnCancel.DialogResult = DialogResult.Cancel

        Dim buttons As New FlowLayoutPanel()
        buttons.AutoSize = True
        buttons.FlowDirection = FlowDirection.RightToLeft
        buttons.Width = 320
        buttons.Margin = New Padding(0, 12, 0, 0)
        buttons.Controls.Add(btnCancel)
        buttons.Controls.Add(btnExport)
        layout.Controls.Add(buttons)

        Me.Controls.Add(layout)
        Me.AcceptButton = btnExport
        Me.CancelButton = btnCancel

        Dim tip As New ToolTip()
        tip.SetToolTip(_cmbFormat, "The file type to create")
        tip.SetToolTip(_txtTitle, "A heading shown at the top of the Excel sheet or PDF")
        tip.SetToolTip(_chkBom, "Lets Excel show accented characters correctly when opening a CSV file")

        UpdateEnabled()
    End Sub

    Private Function MakeRow(caption As String, control As Control) As FlowLayoutPanel
        Dim row As New FlowLayoutPanel()
        row.AutoSize = True
        row.FlowDirection = FlowDirection.LeftToRight

        Dim label As New Label()
        label.Text = caption
        label.Width = 100
        label.Margin = New Padding(0, 6, 0, 0)

        row.Controls.Add(label)
        row.Controls.Add(control)
        Return row
    End Function

    Private Sub UpdateEnabled()
        Dim isCsv As Boolean = (_cmbFormat.SelectedIndex = 2)
        Dim isPdf As Boolean = (_cmbFormat.SelectedIndex = 1)

        _txtTitle.Enabled = Not isCsv
        _chkFooter.Enabled = Not isCsv
        _cmbOrientation.Enabled = isPdf
        _cmbDelimiter.Enabled = isCsv
        _chkBom.Enabled = isCsv
    End Sub

    Private Sub OnExportClicked(sender As Object, e As EventArgs)
        _result.Format = {"Excel", "PDF", "CSV"}(_cmbFormat.SelectedIndex)
        _result.Title = _txtTitle.Text.Trim()
        _result.IncludeHeaders = _chkHeaders.Checked
        _result.IncludeFooter = _chkFooter.Checked
        _result.Landscape = (_cmbOrientation.SelectedIndex = 0)
        _result.Delimiter = {",", ";", vbTab}(_cmbDelimiter.SelectedIndex)
        _result.Utf8Bom = _chkBom.Checked

        Me.DialogResult = DialogResult.OK
        Me.Close()
    End Sub

End Class